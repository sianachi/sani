{
  "name": "sani-mcp",
  "version": "1.0.0-rc.5",
  "description": "Self-hosted broker that lets AI coding agents use authenticated MCP servers and run credentialed shell commands in a Docker sandbox, with per-request human approval",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sianachi/sani.git"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "secrets",
    "sandbox",
    "approval"
  ],
  "bin": {
    "sani-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc",
    "test": "node --test test/*.test.ts",
    "sandbox:build": "node src/index.ts sandbox"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "ipaddr.js": "2.5.0",
    "undici": "7.30.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  },
  "files": [
    "dist",
    "skills",
    "sandbox",
    "README.md",
    "LICENSE"
  ]
}
